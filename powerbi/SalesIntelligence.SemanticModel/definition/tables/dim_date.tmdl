		lineageTag: 48614f3b-a3f8-4896-ad85-6eece59b7804
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		lineageTag: 4e7d9b36-a231-44cc-bd8d-8008732536c7
