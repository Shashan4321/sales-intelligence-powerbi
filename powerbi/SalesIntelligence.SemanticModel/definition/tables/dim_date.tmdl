		summarizeBy: none
		sourceColumn: fiscal_year

	hierarchy Calendar
		lineageTag: 77d5d93d-05a2-4389-ae5c-b9ec720faa2a

		level year
			lineageTag: 52981b1e-b10e-4e79-86f9-cc6c9163b5e3
			column: year

		level quarter
			lineageTag: a8a7b389-d5f6-4146-be34-635bbeb8a9a2
			column: quarter

		level month_name
			lineageTag: 25a6c934-0901-4c5a-92ce-f2e432b0e773
