table dim_date
	lineageTag: 4994eca2-c317-4f56-9bc0-66bb16480b5d
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		lineageTag: e040f178-15de-4244-ab14-134acfdac887
		summarizeBy: none
		sourceColumn: date_key

	column date
		dataType: dateTime
		isKey
		formatString: dd-mmm-yyyy
		lineageTag: 2fa23782-e4ed-4f94-8f29-e6c2de314528
