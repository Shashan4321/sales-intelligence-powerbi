/// Dynamic RLS: each manager sees only the country mapped to their login in security_user_country.
role 'Country Manager'
	modelPermission: read

	tablePermission dim_store =
			dim_store[country]
				IN CALCULATETABLE (
					VALUES ( security_user_country[country] ),
					security_user_country[user_email] = USERPRINCIPALNAME ()
				)

	annotation PBI_Id = a0a30f2ae30f4251ab7da44174e2a772

